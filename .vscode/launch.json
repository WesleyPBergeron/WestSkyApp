    "version": "0.2.0",
    "configurations": [
        {
            "type": "expo",
            "request": "attach",
            "preLaunchTask": "run expo go",
            "name": "Debug Expo Go",
            "projectRoot": "${workspaceFolder}",
            "bundlerPort": "8081",
            "bundlerHost": "127.0.0.1"
        },
        {
            "type": "expo",
            "request": "attach",
            "preLaunchTask": "run expo android",
            "name": "Debug Expo Android",
            "projectRoot": "${workspaceFolder}",
            "bundlerPort": "8081",
            "bundlerHost": "127.0.0.1"
        }
    ]
}